{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whataboutit-collab",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "EPISODE_MEDIA",
      "bucket_name": "whataboutit-collab-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EPISODES",
        "class_name": "EpisodeCollaboration"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EpisodeCollaboration"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  }
}
