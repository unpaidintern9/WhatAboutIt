{
  "name": "what-about-it-studio-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace scripts for What About It? Studio.",
  "scripts": {
    "setup": "cd app && npm ci",
    "dev": "cd app && npm run dev",
    "build": "cd app && npm run build",
    "lint": "cd app && npm run lint",
    "format": "cd app && npm run format",
    "typecheck": "cd app && npm run typecheck",
    "test": "cd app && npm run test",
    "verify": "cd app && npm run verify",
    "package": "cd app && npm run package",
    "package:win": "cd app && npm run package:win",
    "installer:win": "cd app && npm run installer:win",
    "beta:win": "cd app && npm run beta:win",
    "create-shortcut": "cd app && npm run create-shortcut"
  }
}
